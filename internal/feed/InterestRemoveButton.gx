package feed

import "github.com/alternayte/briefing/internal/feed/route"

props {
  // F is the remove form of one interest.
  F route.InterestsRemoveForm
  // Label is the button text.
  Label string = ""
}

<form {...p.F.Attrs()}>
  <button type="submit" class="label min-h-target text-muted-foreground hover:text-destructive">{p.Label}</button>
</form>
