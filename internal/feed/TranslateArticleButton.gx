package feed

import "github.com/alternayte/briefing/internal/feed/route"

props {
  // F is the translate form of one source.
  F route.TranslateArticleForm
  // Label is the button text.
  Label string = ""
}

<form {...p.F.Attrs()}>
  <button type="submit" class="label min-h-target text-muted-foreground hover:text-accent">{p.Label}</button>
</form>
