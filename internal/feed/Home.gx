package feed

import (
  "github.com/alternayte/briefing/internal/feed/route"
  "github.com/alternayte/briefing/internal/i18n"
)

props {
  // Msg is the catalog of the request locale.
  Msg i18n.Messages
  // LoadedAt is when the page was built, as Unix seconds.
  LoadedAt int64 = 0
  // Today holds the stories delivered today; More the ones that waited.
  Today []Card = nil
  More []Card = nil
  // CaughtUp is true when the reader saw every story of today.
  CaughtUp bool = false
}

<gx.Head title={p.Msg.FeedTitle + " · " + p.Msg.AppName} />
<div on:interval(60s)={route.Fresh{Since: p.LoadedAt}}>
  text := ""
  show := ""
  <p #fresh(text string, show string) role="status" aria-live="polite">
    if text != "" {
      <span class="mt-half flex items-baseline justify-between gap-half border-y border-foreground py-quarter text-small">{text} <a href="/" class="label text-accent">{show}</a></span>
    }
  </p>
</div>
<h1 class="sr-only">{p.Msg.FeedTitle}</h1>
if len(p.Today) == 0 {
  <p class="pt-line text-muted-foreground italic">{p.Msg.FeedEmpty}</p>
}
<ol class="divide-y divide-border">
  for _, c := range p.Today {
    <li><StoryCard card={c} msg={p.Msg} /></li>
  }
</ol>
if p.CaughtUp {
  <section class="mt-line border-t-2 border-foreground pt-half" aria-live="polite">
    <p class="font-semibold">{p.Msg.FeedCaughtUp}</p>
    <p class="text-small text-muted-foreground">{p.Msg.FeedCaughtUpHint}</p>
  </section>
}
if len(p.More) > 0 {
  <details class="mt-line border-t-2 border-foreground">
    <summary class="label min-h-target cursor-pointer py-half">{p.Msg.FeedMore} ({len(p.More)})</summary>
    <ol class="divide-y divide-border">
      for _, c := range p.More {
        <li><StoryCard card={c} msg={p.Msg} /></li>
      }
    </ol>
  </details>
}
