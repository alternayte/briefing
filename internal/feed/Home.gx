package feed

import (
  "github.com/alternayte/briefing/internal/feed/route"
  "github.com/alternayte/briefing/internal/i18n"
)

props {
  // Msg is the catalog of the request locale.
  Msg i18n.Messages
  // LoadedAt is when the page was built, as Unix seconds.
  LoadedAt int64 = 0
  // Today holds the stories delivered today; Done the ones the reader took
  // off Today; More the ones that waited.
  Today []Card = nil
  Done []Card = nil
  More []Card = nil
  // ClearRead is the form that marks every read story of today done.
  ClearRead DoneButtonProps
  // Budget and Zone feed the help: the daily budget and the time zone.
  Budget int = 0
  Zone string = ""
  // CaughtUp is true when the reader saw every story of today.
  CaughtUp bool = false
  // ReviewCard words the due questions, or is empty.
  ReviewCard string = ""
}

<gx.Head title={p.Msg.FeedTitle + " · " + p.Msg.AppName} />
<div on:interval(60s)={route.Fresh{Since: p.LoadedAt}}>
  text := ""
  show := ""
  <p #fresh(text string, show string) role="status" aria-live="polite">
    if text != "" {
      <span class="mt-half flex items-baseline justify-between gap-half border-y border-foreground py-quarter text-small">{text} <a href="/" class="label text-accent">{show}</a></span>
    }
  </p>
</div>
<h1 class="sr-only">{p.Msg.FeedTitle}</h1>
if p.ReviewCard != "" {
  <a href="/review" class="mt-half flex min-h-target items-center justify-between gap-half border-2 border-foreground px-half py-quarter hover:border-accent">
    <span class="font-semibold">{p.ReviewCard}</span>
    <span class="label text-accent">{p.Msg.ReviewOpen} →</span>
  </a>
}
<div class="mt-half flex items-center justify-end gap-quarter">
  <DoneButton f={p.ClearRead.F} label={p.Msg.FeedClearRead} allSeen={true} />
  <HelpDialog msg={p.Msg} budget={p.Budget} zone={p.Zone} />
</div>
today := p.Today
done := p.Done
more := p.More
caughtUp := p.CaughtUp
<div #feed(today []Card, done []Card, more []Card, caughtUp bool)>
  if len(today) == 0 && len(done) == 0 {
    <p class="pt-line text-muted-foreground italic">{p.Msg.FeedEmpty}</p>
  }
  <ol class="divide-y divide-border">
    for _, c := range today {
      <li><StoryCard card={c} msg={p.Msg} /></li>
    }
  </ol>
  if caughtUp {
    <section class="mt-line border-t-2 border-foreground pt-half" aria-live="polite">
      <p class="font-semibold">{p.Msg.FeedCaughtUp}</p>
      <p class="text-small text-muted-foreground">{p.Msg.FeedCaughtUpHint}</p>
    </section>
  }
  if len(done) > 0 {
    <details class="mt-line border-t-2 border-foreground">
      <summary class="label min-h-target cursor-pointer py-half">{p.Msg.FeedDoneToday} ({len(done)})</summary>
      <ol class="divide-y divide-border">
        for _, c := range done {
          <li><StoryCard card={c} msg={p.Msg} /></li>
        }
      </ol>
    </details>
  }
  if len(more) > 0 {
    <details class="mt-line border-t-2 border-foreground">
      <summary class="label min-h-target cursor-pointer py-half">{p.Msg.FeedMore} ({len(more)})</summary>
      <ol class="divide-y divide-border">
        for _, c := range more {
          <li><StoryCard card={c} msg={p.Msg} /></li>
        }
      </ol>
    </details>
  }
</div>
