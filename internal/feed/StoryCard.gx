package feed

import (
  "strings"

  "github.com/alternayte/briefing/internal/feed/route"
  "github.com/alternayte/briefing/internal/i18n"
)

props {
  // Card is the story.
  Card Card
  // Msg is the catalog of the request locale.
  Msg i18n.Messages
}

<article id={entryID(p.Card.StoryID)} class="py-line" aria-labelledby={"story-" + gx.TextValue(p.Card.StoryID)}>
  if p.Card.Updated {
    <p class="label text-accent">{p.Msg.StoryUpdated}</p>
  }
  if p.Card.Translating {
    <p class="label text-muted-foreground" lang="en">{p.Msg.FeedTranslating}</p>
  }
  <h2 id={"story-" + gx.TextValue(p.Card.StoryID)} class="text-deck leading-tight font-semibold" class:text-muted-foreground={p.Card.Seen}><a href={route.Read{ID: p.Card.StoryID}} class="hover:text-accent">{p.Card.Headline}</a></h2>
  if p.Card.LinkCard {
    <p class="mt-quarter text-small text-muted-foreground">{p.Card.Summary}</p>
    <p class="mt-quarter text-small">{p.Msg.FeedLinkCard} <a href={p.Card.LinkURL} rel="noopener" class="text-accent underline underline-offset-2">{p.Card.Sources[0].Domain}</a></p>
  } else {
    <p class="mt-quarter">{p.Card.Summary}</p>
  }
  if len(p.Card.Concepts) > 0 {
    <ul class="mt-half flex flex-wrap gap-quarter" aria-label="concepts">
      for _, name := range p.Card.Concepts {
        <li class="label border border-border px-quarter text-muted-foreground">{name}</li>
      }
    </ul>
  }
  <footer class="mt-half text-small text-muted-foreground">
    <ul class="flex flex-wrap items-center gap-x-half">
      for _, s := range p.Card.Sources {
        <li><a href={s.URL} rel="noopener" title={s.Domain} class="inline-flex min-h-target items-center gap-quarter hover:text-foreground"><img src={s.Favicon} alt="" width="16" height="16" loading="lazy" class="size-4" />{s.Domain}</a></li>
      }
    </ul>
    if len(p.Card.Meta) > 0 {
      <p>{strings.Join(p.Card.Meta, " · ")}</p>
    }
    if p.Card.Reason != "" {
      <p class="label mt-quarter">{p.Card.Reason}</p>
    }
  </footer>
  <FeedbackGroup storyID={p.Card.StoryID} buttons={p.Card.Feedback} msg={p.Msg} />
</article>
